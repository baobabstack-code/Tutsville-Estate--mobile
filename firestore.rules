rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Catch-All Deny Default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    // Validation Helpers
    function isValidCase(data) {
      return data.userId is string &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 150 &&
             data.description is string && data.description.size() <= 1500 &&
             data.category is string &&
             data.priority is string &&
             data.location is string &&
             data.status in ['OPEN', 'ASSIGNED', 'IN_PROGRESS', 'RESOLVED'];
    }

    function isValidProperty(data) {
      return data.unitNumber is string && data.unitNumber.size() >= 2 &&
             data.pavilionWing is string &&
             data.bedrooms is int &&
             (data.bathrooms is int || data.bathrooms is float) &&
             data.sqFt is int &&
             data.status in ['AVAILABLE', 'OCCUPIED', 'MAINTENANCE'];
    }

    function isValidTenant(data) {
      return data.fullName is string && data.fullName.size() >= 2 &&
             data.email is string &&
             data.phone is string &&
             data.emergencyContactName is string &&
             data.emergencyContactPhone is string &&
             data.inviteCode is string;
    }

    function isValidFacility(data) {
      return data.name is string && data.name.size() >= 2 &&
             data.location is string &&
             data.capacity is int;
    }

    function isValidBooking(data) {
      return data.userId is string &&
             data.facilityId is string &&
             data.facilityName is string &&
             data.date is string &&
             data.timeSlot is string &&
             data.guestCount is int && data.guestCount >= 1;
    }

    function isValidMaintenance(data) {
      return data.userId is string &&
             data.title is string && data.title.size() >= 3 &&
             data.discipline is string &&
             data.scheduledDate is string &&
             data.contractorName is string &&
             data.status in ['SCHEDULED', 'IN_PROGRESS', 'COMPLETED', 'OVERDUE'];
    }

    function isValidContract(data) {
      return data.vendorName is string &&
             data.serviceCategory is string &&
             data.annualValue is string &&
             data.renewalDate is string &&
             data.daysRemaining is int;
    }

    function isValidReminder(data) {
      return data.userId is string &&
             data.title is string && data.title.size() >= 2 &&
             data.message is string &&
             data.targetAudience is string &&
             data.urgency is string;
    }

    function isValidVendor(data) {
      return data.name is string && data.name.size() >= 2 &&
             data.category is string &&
             data.phone is string &&
             (data.rating is int || data.rating is float) &&
             data.activeJobsCount is int;
    }

    // 1. Cases Collection
    match /cases/{caseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(caseId) && isValidCase(incoming());
      allow update: if isSignedIn() && isValidId(caseId) && isValidCase(incoming());
      allow delete: if isSignedIn();
    }

    // 2. Properties Collection
    match /properties/{propertyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(propertyId) && isValidProperty(incoming());
      allow update: if isSignedIn() && isValidId(propertyId) && isValidProperty(incoming());
      allow delete: if isSignedIn();
    }

    // 3. Tenants Collection
    match /tenants/{tenantId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(tenantId) && isValidTenant(incoming());
      allow update: if isSignedIn() && isValidId(tenantId) && isValidTenant(incoming());
      allow delete: if isSignedIn();
    }

    // 4. Facilities Collection
    match /facilities/{facilityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(facilityId) && isValidFacility(incoming());
      allow update: if isSignedIn() && isValidId(facilityId) && isValidFacility(incoming());
      allow delete: if isSignedIn();
    }

    // 5. Facility Bookings Collection
    match /bookings/{bookingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(bookingId) && isValidBooking(incoming());
      allow update: if isSignedIn() && isValidId(bookingId) && isValidBooking(incoming());
      allow delete: if isSignedIn();
    }

    // 6. Maintenance Events Collection
    match /maintenances/{maintenanceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(maintenanceId) && isValidMaintenance(incoming());
      allow update: if isSignedIn() && isValidId(maintenanceId) && isValidMaintenance(incoming());
      allow delete: if isSignedIn();
    }

    // 7. Vendor Contracts Collection
    match /contracts/{contractId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(contractId) && isValidContract(incoming());
      allow update: if isSignedIn() && isValidId(contractId) && isValidContract(incoming());
      allow delete: if isSignedIn();
    }

    // 8. Reminders Collection
    match /reminders/{reminderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(reminderId) && isValidReminder(incoming());
      allow update: if isSignedIn() && isValidId(reminderId) && isValidReminder(incoming());
      allow delete: if isSignedIn();
    }

    // 9. Approved Vendors Collection
    match /vendors/{vendorId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(vendorId) && isValidVendor(incoming());
      allow update: if isSignedIn() && isValidId(vendorId) && isValidVendor(incoming());
      allow delete: if isSignedIn();
    }
  }
}
