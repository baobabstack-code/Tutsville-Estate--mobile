rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(id) {
      return id is string && id.size() >= 3 && id.size() <= 200 && id.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+$');
    }

    function isVerifiedEmail() {
      return isSignedIn() &&
             'email' in request.auth.token &&
             request.auth.token.email is string &&
             request.auth.token.email_verified == true;
    }

    function tokenEmail() {
      return request.auth.token.email.lower();
    }

    function isBootstrappedManagerEmail() {
      return isVerifiedEmail() && tokenEmail() == 'baobabstack@gmail.com';
    }

    function isInvitedManagerEmail() {
      return isVerifiedEmail() &&
             exists(/databases/$(database)/documents/manager_invites/$(tokenEmail()));
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isBootstrappedManagerEmail()
      );
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidStringList(listVal, maxItems) {
      return listVal is list && listVal.size() <= maxItems && (listVal.size() == 0 || listVal[0] is string);
    }

    function isValidMapList(listVal, maxItems) {
      return listVal is list && listVal.size() <= maxItems && (listVal.size() == 0 || listVal[0] is map);
    }

    // --- Validation Helpers (Anti-Update-Gap Blueprints) ---
    function isValidAdmin(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
             isValidOptionalString(data, 'displayName', 120) &&
             data.role == 'ADMIN';
    }

    function isValidManagerInvite(data) {
      return data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
             isValidOptionalString(data, 'displayName', 120) &&
             isValidOptionalString(data, 'invitedByEmail', 200) &&
             isValidOptionalString(data, 'invitedDate', 60) &&
             data.status in ['PENDING', 'CLAIMED'];
    }

    function isValidEstateConfig(data) {
      return isValidStringList(data.floorElevations, 40) &&
             isValidStringList(data.contractorDisciplines, 40);
    }

    function isValidCase(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             isValidOptionalString(data, 'tenantEmail', 200) &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 150 &&
             data.description is string && data.description.size() <= 1500 &&
             data.category is string && data.category.size() <= 50 &&
             data.priority is string && data.priority.size() <= 30 &&
             data.location is string && data.location.size() >= 1 && data.location.size() <= 150 &&
             isValidOptionalString(data, 'reportedBy', 120) &&
             isValidOptionalString(data, 'reportedDate', 60) &&
             isValidOptionalString(data, 'preferredDate', 60) &&
             isValidOptionalString(data, 'assignedVendorId', 128) &&
             isValidOptionalString(data, 'assignedVendorName', 150) &&
             data.status in ['OPEN', 'ASSIGNED', 'IN_PROGRESS', 'RESOLVED'] &&
             (!('notes' in data) || isValidMapList(data.notes, 60)) &&
             (!('statusHistory' in data) || isValidMapList(data.statusHistory, 100)) &&
             (!('createdAtEpochMs' in data) || (data.createdAtEpochMs is number && data.createdAtEpochMs >= 0)) &&
             (!('rating' in data) || data.rating == null || (data.rating is int && data.rating >= 1 && data.rating <= 5)) &&
             isValidOptionalString(data, 'reviewComment', 1000) &&
             (!('reviewTags' in data) || data.reviewTags == null || isValidStringList(data.reviewTags, 10)) &&
             isValidOptionalString(data, 'photoNote', 500);
    }

    function isValidProperty(data) {
      return data.unitNumber is string && data.unitNumber.size() >= 2 && data.unitNumber.size() <= 100 &&
             data.pavilionWing is string && data.pavilionWing.size() <= 100 &&
             data.bedrooms is number && data.bedrooms >= 0 && data.bedrooms <= 50 &&
             data.bathrooms is number && data.bathrooms >= 0 && data.bathrooms <= 50 &&
             data.sqFt is number && data.sqFt >= 0 && data.sqFt <= 100000 &&
             (!('sqMeters' in data) || (data.sqMeters is number && data.sqMeters >= 0 && data.sqMeters <= 100000)) &&
             isValidOptionalString(data, 'floorLevel', 80) &&
             isValidOptionalString(data, 'viewType', 120) &&
             (!('parkingSpots' in data) || isValidStringList(data.parkingSpots, 20)) &&
             (!('amenities' in data) || isValidStringList(data.amenities, 30)) &&
             isValidOptionalString(data, 'monthlyRental', 80) &&
             data.status in ['AVAILABLE', 'OCCUPIED', 'MAINTENANCE', 'UNDER_MAINTENANCE'] &&
             isValidOptionalString(data, 'tenantEmail', 200) &&
             (!('assignedTenant' in data) || data.assignedTenant == null || data.assignedTenant is map) &&
             isValidOptionalString(data, 'listedDate', 60);
    }

    function isValidTenant(data) {
      return isValidOptionalString(data, 'firstName', 100) &&
             isValidOptionalString(data, 'lastName', 100) &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 150 &&
             isValidOptionalString(data, 'nationalId', 80) &&
             isValidOptionalString(data, 'address', 300) &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
             isValidOptionalString(data, 'phone', 60) &&
             isValidOptionalString(data, 'emergencyContactName', 150) &&
             isValidOptionalString(data, 'emergencyContactPhone', 60) &&
             isValidOptionalString(data, 'assignedPropertyId', 128) &&
             isValidOptionalString(data, 'assignedPropertyUnit', 100) &&
             isValidOptionalString(data, 'leaseStartDate', 60) &&
             isValidOptionalString(data, 'leaseEndDate', 60) &&
             data.inviteCode is string && data.inviteCode.size() >= 2 && data.inviteCode.size() <= 80 &&
             (!('isAppRegistered' in data) || data.isAppRegistered is bool);
    }

    function isValidFacility(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
             isValidOptionalString(data, 'tag', 60) &&
             data.location is string && data.location.size() <= 150 &&
             data.capacity is number && data.capacity >= 1 && data.capacity <= 5000 &&
             isValidOptionalString(data, 'description', 1000) &&
             (!('amenities' in data) || isValidStringList(data.amenities, 30)) &&
             (!('allowedSlots' in data) || isValidStringList(data.allowedSlots, 30)) &&
             isValidOptionalString(data, 'rules', 1000);
    }

    function isValidBooking(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.facilityId is string && data.facilityId.size() >= 1 && data.facilityId.size() <= 128 &&
             data.facilityName is string && data.facilityName.size() <= 120 &&
             isValidOptionalString(data, 'residentName', 120) &&
             isValidOptionalString(data, 'unit', 100) &&
             data.date is string && data.date.size() >= 3 && data.date.size() <= 60 &&
             data.timeSlot is string && data.timeSlot.size() >= 3 && data.timeSlot.size() <= 80 &&
             isValidOptionalString(data, 'startTime', 30) &&
             isValidOptionalString(data, 'endTime', 30) &&
             (!('startHour' in data) || (data.startHour is number && data.startHour >= 0 && data.startHour <= 23)) &&
             (!('durationHours' in data) || (data.durationHours is number && data.durationHours >= 1 && data.durationHours <= 12)) &&
             data.guestCount is number && data.guestCount >= 1 && data.guestCount <= 5000 &&
             isValidOptionalString(data, 'notes', 500) &&
             isValidOptionalString(data, 'confirmedTimestamp', 80) &&
             (!('approvalStatus' in data) || data.approvalStatus in ['PENDING', 'APPROVED', 'DECLINED']);
    }

    function isValidSlotLock(data) {
      return data.facilityId is string && data.facilityId.size() >= 1 && data.facilityId.size() <= 128 &&
             data.dateKey is string && data.dateKey.size() >= 4 && data.dateKey.size() <= 40 &&
             data.timeSlot is string && data.timeSlot.size() >= 3 && data.timeSlot.size() <= 80 &&
             data.bookingId is string && data.bookingId.size() >= 1 && data.bookingId.size() <= 128 &&
             data.bookedByUid is string && data.bookedByUid.size() >= 1 && data.bookedByUid.size() <= 128;
    }

    function isValidMaintenance(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 150 &&
             data.discipline is string && data.discipline.size() <= 60 &&
             (!('eventCategory' in data) || data.eventCategory in ['MAINTENANCE', 'GENERAL', 'INSPECTION', 'COMMUNITY']) &&
             data.scheduledDate is string && data.scheduledDate.size() <= 60 &&
             isValidOptionalString(data, 'scheduledTime', 80) &&
             data.contractorName is string && data.contractorName.size() <= 150 &&
             isValidOptionalString(data, 'targetArea', 150) &&
             (!('targetScope' in data) || data.targetScope in ['ALL_RESIDENTS', 'SPECIFIC_UNITS']) &&
             (!('targetUnits' in data) || isValidStringList(data.targetUnits, 50)) &&
             (!('intervalMonths' in data) || (data.intervalMonths is number && data.intervalMonths >= 0 && data.intervalMonths <= 120)) &&
             data.status in ['SCHEDULED', 'IN_PROGRESS', 'COMPLETED', 'OVERDUE'] &&
             isValidOptionalString(data, 'notes', 1000);
    }

    function isValidContract(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
             (isValidOptionalString(data, 'counterparty', 150) && isValidOptionalString(data, 'vendorName', 150)) &&
             isValidOptionalString(data, 'unit', 120) &&
             (!('type' in data) || data.type in ['VENDOR_SLA', 'TENANT_LEASE', 'EQUIPMENT_WARRANTY']) &&
             isValidOptionalString(data, 'serviceCategory', 60) &&
             data.annualValue is string && data.annualValue.size() <= 80 &&
             isValidOptionalString(data, 'startDate', 60) &&
             isValidOptionalString(data, 'expiryDate', 60) &&
             isValidOptionalString(data, 'renewalDate', 60) &&
             data.daysRemaining is number && data.daysRemaining >= 0 && data.daysRemaining <= 36500 &&
             isValidOptionalString(data, 'renewalTerms', 1500) &&
             isValidOptionalString(data, 'contactPerson', 150) &&
             isValidOptionalString(data, 'contactEmail', 200) &&
             (!('isNotificationSent' in data) || data.isNotificationSent is bool) &&
             isValidOptionalString(data, 'tenantId', 128) &&
             isValidOptionalString(data, 'tenantEmail', 200) &&
             isValidOptionalString(data, 'propertyId', 128) &&
             isValidOptionalString(data, 'managerName', 150) &&
             isValidOptionalString(data, 'managerEmail', 200) &&
             (!('leaseStatus' in data) || data.leaseStatus in ['PENDING_SIGNATURE', 'ACTIVE', 'EXPIRED', 'TERMINATED']) &&
             (!('isSignedByTenant' in data) || data.isSignedByTenant is bool) &&
             isValidOptionalString(data, 'signedByName', 150) &&
             isValidOptionalString(data, 'signedByEmail', 200) &&
             isValidOptionalString(data, 'signedAt', 80) &&
             (!('isArchived' in data) || data.isArchived is bool) &&
             (!('signedContractDoc' in data) || data.signedContractDoc == null || data.signedContractDoc is map) &&
             (!('codeOfConductDoc' in data) || data.codeOfConductDoc == null || data.codeOfConductDoc is map);
    }

    function isValidReminder(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 150 &&
             data.message is string && data.message.size() <= 1500 &&
             data.targetAudience is string && data.targetAudience.size() >= 1 && data.targetAudience.size() <= 120 &&
             data.urgency is string && data.urgency.size() >= 1 && data.urgency.size() <= 60 &&
             data.recordType in ['ANNOUNCEMENT', 'ACTIVITY'] &&
             data.triggerEvent in [
               'MANUAL_ADVISORY', 'CASE_CREATED', 'CASE_UPDATED',
               'CASE_VENDOR_ASSIGNED', 'CASE_STATUS_UPDATED', 'CASE_NOTE_ADDED', 'CASE_REVIEWED',
               'AMENITY_BOOKED', 'AMENITY_APPROVED', 'AMENITY_DECLINED', 'AMENITY_CANCELLED',
               'EVENT_SCHEDULED'
             ] &&
             data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
             data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 150 &&
             data.createdByEmail is string && data.createdByEmail.size() <= 200 &&
             data.createdByRole in ['MANAGER', 'TENANT'] &&
             isValidOptionalString(data, 'timestamp', 80) &&
             (!('isBroadcast' in data) || data.isBroadcast is bool) &&
             isValidOptionalString(data, 'targetEmail', 200) &&
             (!('targetEmails' in data) || isValidStringList(data.targetEmails, 60)) &&
             isValidOptionalString(data, 'targetUnit', 120) &&
             (!('targetUnits' in data) || isValidStringList(data.targetUnits, 50)) &&
             (!('relatedEntityType' in data) || data.relatedEntityType in ['ADVISORY', 'CASE', 'BOOKING', 'EVENT']) &&
             isValidOptionalString(data, 'relatedEntityId', 128) &&
             (!('createdAtEpochMs' in data) || (data.createdAtEpochMs is number && data.createdAtEpochMs >= 0));
    }

    function isReminderVisibleToResident(data) {
      return isVerifiedEmail() && (
        data.targetAudience in ['ALL_RESIDENTS', 'ALL_USERS', 'All Residents & Tenants', 'All Residents'] ||
        ('targetEmail' in data && data.targetEmail == tokenEmail()) ||
        ('targetEmails' in data && tokenEmail() in data.targetEmails) ||
        data.createdByUid == request.auth.uid
      );
    }

    function isValidNoticeState(data, userId) {
      return data.uid is string && data.uid == userId &&
             isValidStringList(data.readNoticeIds, 500);
    }

    function isValidVendor(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 150 &&
             isValidOptionalString(data, 'category', 60) &&
             isValidOptionalString(data, 'specialty', 60) &&
             isValidOptionalString(data, 'discipline', 80) &&
             data.phone is string && data.phone.size() <= 60 &&
             isValidOptionalString(data, 'email', 200) &&
             isValidOptionalString(data, 'leadTech', 120) &&
             data.rating is number && data.rating >= 0 && data.rating <= 5 &&
             (!('reviewCount' in data) || (data.reviewCount is number && data.reviewCount >= 0)) &&
             data.activeJobsCount is number && data.activeJobsCount >= 0;
    }

    function isCaseParticipant(data) {
      return isSignedIn() && (
        data.userId == request.auth.uid ||
        (isVerifiedEmail() && 'tenantEmail' in data && data.tenantEmail == tokenEmail())
      );
    }

    // --- 0. Admins Allowlist Collection ---
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
                       isValidId(adminUid) &&
                       request.auth.uid == adminUid &&
                       (isBootstrappedManagerEmail() || isInvitedManagerEmail()) &&
                       isValidAdmin(incoming()) &&
                       incoming().uid == request.auth.uid &&
                       incoming().keys().hasAll(['uid', 'email', 'role', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);
      allow update: if isAdmin() &&
                       isValidId(adminUid) &&
                       isValidAdmin(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(adminUid) && existing().email != 'baobabstack@gmail.com';
    }

    // --- 0b. Manager / Landlord Invites Collection ---
    match /manager_invites/{inviteId} {
      allow get: if isSignedIn() && isValidEmailId(inviteId) && (isAdmin() || (isVerifiedEmail() && inviteId == tokenEmail()));
      allow list: if isAdmin() || (isVerifiedEmail() && existing().email == tokenEmail());
      allow create: if isAdmin() &&
                       isValidEmailId(inviteId) &&
                       isValidManagerInvite(incoming()) &&
                       incoming().email == inviteId &&
                       incoming().status == 'PENDING' &&
                       incoming().keys().hasAll(['email', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['email', 'displayName', 'invitedByEmail', 'invitedDate', 'status', 'createdAt', 'updatedAt']) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);
      allow update: if isSignedIn() &&
                       isValidEmailId(inviteId) &&
                       isValidManagerInvite(incoming()) &&
                       incoming().email == existing().email &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       (
                         isAdmin() ||
                         (
                           isVerifiedEmail() &&
                           existing().email == tokenEmail() &&
                           existing().status == 'PENDING' &&
                           incoming().status == 'CLAIMED' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
                         )
                       );
      allow delete: if isAdmin() && isValidEmailId(inviteId);
    }

    // --- 0c. Estate Configurable Options ---
    match /estate_config/{configId} {
      allow get: if isSignedIn() && isValidId(configId);
      allow list: if isSignedIn();
      allow create: if isAdmin() &&
                       isValidId(configId) &&
                       isValidEstateConfig(incoming()) &&
                       incoming().keys().hasAll(['floorElevations', 'contractorDisciplines', 'updatedAt']) &&
                       incoming().keys().hasOnly(['floorElevations', 'contractorDisciplines', 'createdAt', 'updatedAt']) &&
                       isValidTimestamp(incoming().updatedAt);
      allow update: if isAdmin() &&
                       isValidId(configId) &&
                       isValidEstateConfig(incoming()) &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['floorElevations', 'contractorDisciplines', 'updatedAt']);
      allow delete: if false;
    }

    // --- 1. Cases Collection ---
    match /cases/{caseId} {
      allow get: if isSignedIn() && isValidId(caseId) && (isAdmin() || isCaseParticipant(existing()));
      allow list: if isSignedIn() && (isAdmin() || isCaseParticipant(existing()));
      allow create: if isSignedIn() &&
                       isValidId(caseId) &&
                       isValidCase(incoming()) &&
                       incoming().keys().hasAll(['userId', 'title', 'description', 'category', 'priority', 'location', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly([
                         'userId', 'tenantEmail', 'title', 'description', 'category', 'priority',
                         'location', 'reportedBy', 'reportedDate', 'preferredDate',
                         'assignedVendorId', 'assignedVendorName', 'status',
                         'notes', 'statusHistory', 'createdAtEpochMs',
                         'rating', 'reviewComment', 'reviewTags', 'photoNote',
                         'createdAt', 'updatedAt'
                       ]) &&
                       (isAdmin() || (incoming().userId == request.auth.uid && incoming().status == 'OPEN')) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);
      allow update: if isSignedIn() &&
                       isValidId(caseId) &&
                       isValidCase(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       (
                         (
                           // Manager preserves original resident complaint description after submission
                           isAdmin() &&
                           incoming().description == existing().description
                         ) ||
                         (
                           // Action: Tenant edits their own OPEN case
                           isCaseParticipant(existing()) &&
                           existing().status == 'OPEN' &&
                           incoming().status == 'OPEN' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'location', 'category', 'priority', 'preferredDate', 'updatedAt'])
                         )
                       );
      allow delete: if isSignedIn() && isValidId(caseId) && (isAdmin() || (existing().status == 'OPEN' && isCaseParticipant(existing())));
    }

    // --- 2. Properties Collection ---
    match /properties/{propertyId} {
      allow get: if isSignedIn() && isValidId(propertyId) && (isAdmin() || (isVerifiedEmail() && 'tenantEmail' in existing() && existing().tenantEmail == tokenEmail()));
      allow list: if isSignedIn() && (isAdmin() || (isVerifiedEmail() && 'tenantEmail' in existing() && existing().tenantEmail == tokenEmail()));
      allow create: if isAdmin() &&
                       isValidId(propertyId) &&
                       isValidProperty(incoming()) &&
                       incoming().keys().hasAll(['unitNumber', 'pavilionWing', 'bedrooms', 'bathrooms', 'sqFt', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly([
                         'unitNumber', 'pavilionWing', 'bedrooms', 'bathrooms', 'sqFt', 'sqMeters',
                         'floorLevel', 'viewType', 'parkingSpots', 'amenities', 'monthlyRental',
                         'status', 'tenantEmail', 'assignedTenant', 'listedDate', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);
      allow update: if isSignedIn() &&
                       isValidId(propertyId) &&
                       isValidProperty(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       (
                         isAdmin() ||
                         (
                           // Action: Resident claims onboarding invite on their assigned unit
                           isVerifiedEmail() &&
                           'tenantEmail' in existing() &&
                           existing().tenantEmail == tokenEmail() &&
                           existing().assignedTenant is map &&
                           incoming().assignedTenant is map &&
                           incoming().assignedTenant.email == existing().assignedTenant.email &&
                           incoming().assignedTenant.isClaimed == true &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['assignedTenant', 'updatedAt'])
                         )
                       );
      allow delete: if isAdmin() && isValidId(propertyId);
    }

    // --- 3. Tenants Collection ---
    match /tenants/{tenantId} {
      allow get: if isSignedIn() && isValidId(tenantId) && (isAdmin() || (isVerifiedEmail() && existing().email == tokenEmail()));
      allow list: if isSignedIn() && (isAdmin() || (isVerifiedEmail() && existing().email == tokenEmail()));
      allow create: if isAdmin() &&
                       isValidId(tenantId) &&
                       isValidTenant(incoming()) &&
                       incoming().keys().hasAll(['fullName', 'email', 'inviteCode', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['firstName', 'lastName', 'fullName', 'nationalId', 'address', 'email', 'phone', 'emergencyContactName', 'emergencyContactPhone', 'assignedPropertyId', 'assignedPropertyUnit', 'leaseStartDate', 'leaseEndDate', 'inviteCode', 'isAppRegistered', 'createdAt', 'updatedAt']) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);
      allow update: if isSignedIn() &&
                       isValidId(tenantId) &&
                       isValidTenant(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       (
                         isAdmin() ||
                         (
                           // Action: Resident claims verified app registration status
                           isVerifiedEmail() &&
                           existing().email == tokenEmail() &&
                           incoming().isAppRegistered == true &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['isAppRegistered', 'updatedAt'])
                         )
                       );
      allow delete: if isAdmin() && isValidId(tenantId);
    }

    // --- 4. Facilities Collection (Shared Non-PII Directory) ---
    match /facilities/{facilityId} {
      allow get: if isSignedIn() && isValidId(facilityId);
      allow list: if isSignedIn();
      allow create: if isAdmin() &&
                       isValidId(facilityId) &&
                       isValidFacility(incoming()) &&
                       incoming().keys().hasAll(['name', 'location', 'capacity', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['name', 'tag', 'location', 'capacity', 'description', 'amenities', 'allowedSlots', 'rules', 'createdAt', 'updatedAt']) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);
      allow update: if isAdmin() &&
                       isValidId(facilityId) &&
                       isValidFacility(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt);
      allow delete: if isAdmin() && isValidId(facilityId);
    }

    // --- 5. Facility Bookings Collection (Owner + Admin Isolated) ---
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId) && (isAdmin() || existing().userId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
      allow create: if isSignedIn() &&
                       isValidId(bookingId) &&
                       isValidBooking(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       (isAdmin() || !('approvalStatus' in incoming()) || incoming().approvalStatus == 'PENDING') &&
                       incoming().keys().hasAll(['userId', 'facilityId', 'facilityName', 'date', 'timeSlot', 'guestCount', 'createdAt']) &&
                       incoming().keys().hasOnly([
                         'userId', 'facilityId', 'facilityName', 'residentName', 'unit',
                         'date', 'timeSlot', 'startTime', 'endTime', 'startHour', 'durationHours',
                         'guestCount', 'notes', 'confirmedTimestamp', 'approvalStatus', 'createdAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       exists(/databases/$(database)/documents/facilities/$(incoming().facilityId));
      allow update: if isAdmin() &&
                       isValidId(bookingId) &&
                       isValidBooking(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(bookingId) && (isAdmin() || existing().userId == request.auth.uid);
    }

    // --- 5b. Atomic Slot Locks Collection (Non-PII Overlap Prevention) ---
    match /slot_locks/{lockId} {
      allow get: if isSignedIn() && isValidId(lockId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
                       isValidId(lockId) &&
                       isValidSlotLock(incoming()) &&
                       (isAdmin() || incoming().bookedByUid == request.auth.uid) &&
                       incoming().keys().hasAll(['facilityId', 'dateKey', 'timeSlot', 'bookingId', 'bookedByUid', 'createdAt']) &&
                       incoming().keys().hasOnly(['facilityId', 'dateKey', 'timeSlot', 'bookingId', 'bookedByUid', 'createdAt']) &&
                       isValidTimestamp(incoming().createdAt) &&
                       !exists(/databases/$(database)/documents/slot_locks/$(lockId)) &&
                       exists(/databases/$(database)/documents/facilities/$(incoming().facilityId)) &&
                       existsAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId));
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(lockId) && (isAdmin() || existing().bookedByUid == request.auth.uid);
    }

    // --- 6. Maintenance & Estate Calendar Events Collection ---
    match /maintenances/{maintenanceId} {
      allow get: if isSignedIn() && isValidId(maintenanceId);
      allow list: if isSignedIn();
      allow create: if isAdmin() &&
                       isValidId(maintenanceId) &&
                       isValidMaintenance(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'title', 'discipline', 'scheduledDate', 'contractorName', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'discipline', 'eventCategory', 'scheduledDate', 'scheduledTime',
                         'contractorName', 'targetArea', 'targetScope', 'targetUnits',
                         'intervalMonths', 'status', 'notes', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);
      allow update: if isAdmin() &&
                       isValidId(maintenanceId) &&
                       isValidMaintenance(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt);
      allow delete: if isAdmin() && isValidId(maintenanceId);
    }

    // --- 7. Bilateral Lease & Contractor Contracts Collection ---
    match /contracts/{contractId} {
      allow get: if isSignedIn() && isValidId(contractId) && (isAdmin() || (isVerifiedEmail() && 'tenantEmail' in existing() && existing().tenantEmail == tokenEmail()));
      allow list: if isSignedIn() && (isAdmin() || (isVerifiedEmail() && 'tenantEmail' in existing() && existing().tenantEmail == tokenEmail()));
      allow create: if isAdmin() &&
                       isValidId(contractId) &&
                       isValidContract(incoming()) &&
                       incoming().keys().hasAll(['title', 'annualValue', 'daysRemaining', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly([
                         'title', 'counterparty', 'vendorName', 'unit', 'serviceCategory', 'type',
                         'annualValue', 'startDate', 'expiryDate', 'renewalDate', 'daysRemaining',
                         'renewalTerms', 'contactPerson', 'contactEmail', 'isNotificationSent',
                         'tenantId', 'tenantEmail', 'propertyId', 'managerName', 'managerEmail',
                         'leaseStatus', 'isSignedByTenant', 'signedByName', 'signedByEmail', 'signedAt',
                         'isArchived', 'signedContractDoc', 'codeOfConductDoc',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);
      allow update: if isAdmin() &&
                       isValidId(contractId) &&
                       isValidContract(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt);
      allow delete: if isAdmin() && isValidId(contractId);
    }

    // --- 8. Attributed Reminders & Advisories Collection ---
    match /reminders/{reminderId} {
      allow get: if isSignedIn() && isValidId(reminderId) && (isAdmin() || (resource != null && isReminderVisibleToResident(existing())));
      allow list: if isSignedIn() && (isAdmin() || isReminderVisibleToResident(existing()));
      allow create: if isSignedIn() &&
                       isValidId(reminderId) &&
                       isValidReminder(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdByUid == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'message', 'targetAudience', 'urgency',
                         'recordType', 'triggerEvent', 'createdByUid', 'createdByName',
                         'createdByEmail', 'createdByRole', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'message', 'targetAudience', 'urgency',
                         'timestamp', 'isBroadcast', 'recordType', 'triggerEvent',
                         'createdByUid', 'createdByName', 'createdByEmail', 'createdByRole',
                         'targetEmail', 'targetEmails', 'targetUnit', 'targetUnits',
                         'relatedEntityType', 'relatedEntityId', 'createdAtEpochMs', 'createdAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       (
                         (isAdmin() && incoming().createdByRole == 'MANAGER') ||
                         (
                           isVerifiedEmail() &&
                           incoming().recordType == 'ACTIVITY' &&
                           incoming().createdByRole == 'TENANT' &&
                           incoming().createdByEmail == tokenEmail() &&
                           incoming().triggerEvent in ['CASE_CREATED', 'CASE_UPDATED', 'AMENITY_BOOKED', 'AMENITY_CANCELLED']
                         )
                       );
      allow update: if isAdmin() &&
                       isValidId(reminderId) &&
                       isValidReminder(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdByUid == existing().createdByUid &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(reminderId);
    }

    // --- 8b. Per-User Synced Notification Read State ---
    match /user_notice_states/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidNoticeState(incoming(), userId) &&
                       incoming().keys().hasAll(['uid', 'readNoticeIds', 'updatedAt']) &&
                       incoming().keys().hasOnly(['uid', 'readNoticeIds', 'updatedAt']) &&
                       isValidTimestamp(incoming().updatedAt);
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidNoticeState(incoming(), userId) &&
                       incoming().uid == existing().uid &&
                       incoming().keys().hasAll(['uid', 'readNoticeIds', 'updatedAt']) &&
                       incoming().keys().hasOnly(['uid', 'readNoticeIds', 'updatedAt']) &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['readNoticeIds', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // --- 9. Approved Contractors Collection ---
    match /vendors/{vendorId} {
      allow get: if isSignedIn() && isValidId(vendorId);
      allow list: if isSignedIn();
      allow create: if isAdmin() &&
                       isValidId(vendorId) &&
                       isValidVendor(incoming()) &&
                       incoming().keys().hasAll(['name', 'phone', 'rating', 'activeJobsCount', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly([
                         'name', 'category', 'specialty', 'discipline',
                         'phone', 'email', 'leadTech', 'rating', 'reviewCount',
                         'activeJobsCount', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);
      allow update: if isAdmin() &&
                       isValidId(vendorId) &&
                       isValidVendor(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt);
      allow delete: if isAdmin() && isValidId(vendorId);
    }
  }
}
