{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Authorized estate manager allowlist entry",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID of the manager" },
        "email": { "type": "string", "description": "Verified Google account email" },
        "displayName": { "type": "string", "description": "Manager display name" },
        "role": { "type": "string", "enum": ["ADMIN"] },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update" }
      },
      "required": ["uid", "email", "role", "createdAt", "updatedAt"]
    },
    "ManagerInvite": {
      "title": "ManagerInvite",
      "description": "Invited co-manager or landlord allowlist entry",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Lowercase invited Google email" },
        "displayName": { "type": "string", "description": "Invited manager/landlord display name" },
        "invitedByEmail": { "type": "string", "description": "Inviter email" },
        "invitedDate": { "type": "string", "description": "Formatted invite date" },
        "status": { "type": "string", "enum": ["PENDING", "CLAIMED"] },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update" }
      },
      "required": ["email", "status", "createdAt", "updatedAt"]
    },
    "EstateConfig": {
      "title": "EstateConfig",
      "description": "Estate-wide configurable dropdown lists for floor elevations, contractor disciplines, amenity tags/times, case disciplines, and engineering disciplines",
      "type": "object",
      "properties": {
        "floorElevations": { "type": "array", "items": { "type": "string" } },
        "contractorDisciplines": { "type": "array", "items": { "type": "string" } },
        "amenityCategoryTags": { "type": "array", "items": { "type": "string" } },
        "amenityTimeSlots": { "type": "array", "items": { "type": "string" } },
        "caseDisciplines": { "type": "array", "items": { "type": "string" } },
        "engineeringDisciplines": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["floorElevations", "contractorDisciplines", "updatedAt"]
    },
    "Case": {
      "title": "Case",
      "description": "Maintenance incident and work order report",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of resident or manager logging the case" },
        "tenantEmail": { "type": "string", "description": "Lowercase email of affected resident" },
        "title": { "type": "string", "description": "Incident summary headline" },
        "description": { "type": "string", "description": "Work order detailed description (immutable after manager triage)" },
        "category": { "type": "string", "description": "Discipline category enum key" },
        "categoryLabel": { "type": "string", "description": "Manager-configured case category discipline display label" },
        "priority": { "type": "string", "description": "Priority SLA level" },
        "location": { "type": "string", "description": "Physical unit or estate area" },
        "reportedBy": { "type": "string", "description": "Display name of reporter" },
        "reportedDate": { "type": "string", "description": "Formatted date" },
        "preferredDate": { "type": "string", "description": "Optional preferred completion date" },
        "assignedVendorId": { "type": "string", "description": "ID of assigned contractor" },
        "assignedVendorName": { "type": "string", "description": "Name of assigned contractor" },
        "status": { "type": "string", "description": "Current resolution status", "enum": ["OPEN", "ASSIGNED", "IN_PROGRESS", "RESOLVED"] },
        "notes": { "type": "array", "items": { "type": "object" }, "description": "Manager chronological case notes" },
        "statusHistory": { "type": "array", "items": { "type": "object" }, "description": "Audit log of status transitions" },
        "createdAtEpochMs": { "type": "integer", "description": "Epoch millis of creation for audit windows" },
        "rating": { "type": "integer", "description": "Legacy rating" },
        "reviewComment": { "type": "string", "description": "Legacy feedback notes" },
        "reviewTags": { "type": "array", "items": { "type": "string" }, "description": "Legacy tags" },
        "photoNote": { "type": "string", "description": "Attachment note" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update" }
      },
      "required": ["userId", "title", "description", "category", "priority", "location", "status", "createdAt", "updatedAt"]
    },
    "Property": {
      "title": "Property",
      "description": "Residential unit, house, or apartment",
      "type": "object",
      "properties": {
        "unitNumber": { "type": "string", "description": "Unit identifier and name" },
        "pavilionWing": { "type": "string", "description": "Legacy optional field" },
        "bedrooms": { "type": "integer", "description": "Bedrooms count" },
        "bathrooms": { "type": "number", "description": "Bathrooms count" },
        "sqFt": { "type": "integer", "description": "Size numeric mirror" },
        "sqMeters": { "type": "integer", "description": "Interior area in square meters" },
        "floorLevel": { "type": "string", "description": "Floor elevation (e.g. 1 Story, 2 Story)" },
        "viewType": { "type": "string", "description": "View and vista description" },
        "parkingSpots": { "type": "array", "items": { "type": "string" }, "description": "Legacy parking field" },
        "amenities": { "type": "array", "items": { "type": "string" }, "description": "In-unit amenities" },
        "monthlyRental": { "type": "string", "description": "Monthly lease valuation" },
        "status": { "type": "string", "description": "Lease status", "enum": ["AVAILABLE", "OCCUPIED", "MAINTENANCE"] },
        "tenantEmail": { "type": "string", "description": "Denormalized lowercase assigned tenant email for scoped reads" },
        "assignedTenant": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "email": { "type": "string" },
            "leaseStartDate": { "type": "string" },
            "leaseEndDate": { "type": "string" },
            "inviteCode": { "type": "string" },
            "inviteLink": { "type": "string" },
            "isClaimed": { "type": "boolean" },
            "assignedTimestamp": { "type": "string" }
          }
        },
        "listedDate": { "type": "string", "description": "Date listed" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update" }
      },
      "required": ["unitNumber", "pavilionWing", "bedrooms", "bathrooms", "sqFt", "status", "createdAt", "updatedAt"]
    },
    "Tenant": {
      "title": "Tenant",
      "description": "Registered resident profile and emergency contact",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "fullName": { "type": "string", "description": "Full legal name" },
        "nationalId": { "type": "string" },
        "address": { "type": "string" },
        "email": { "type": "string", "description": "Registered lowercase email address" },
        "phone": { "type": "string", "description": "Contact mobile phone" },
        "emergencyContactName": { "type": "string", "description": "Emergency contact name" },
        "emergencyContactPhone": { "type": "string", "description": "Emergency contact phone" },
        "assignedPropertyId": { "type": "string", "description": "Assigned property document ID" },
        "assignedPropertyUnit": { "type": "string", "description": "Assigned unit label" },
        "leaseStartDate": { "type": "string", "description": "Lease start date" },
        "leaseEndDate": { "type": "string", "description": "Lease end date" },
        "inviteCode": { "type": "string", "description": "Personal onboarding invite code" },
        "isAppRegistered": { "type": "boolean", "description": "Whether user registered on app" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update" }
      },
      "required": ["fullName", "email", "inviteCode", "createdAt", "updatedAt"]
    },
    "Facility": {
      "title": "Facility",
      "description": "Estate shared amenity and venue",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Amenity title" },
        "tag": { "type": "string", "description": "Amenity tag" },
        "location": { "type": "string", "description": "Physical grounds location" },
        "capacity": { "type": "integer", "description": "Guest capacity" },
        "description": { "type": "string" },
        "allowedSlots": { "type": "array", "items": { "type": "string" }, "description": "Configured time windows" },
        "amenities": { "type": "array", "items": { "type": "string" }, "description": "Facility amenities" },
        "rules": { "type": "string", "description": "Facility notes" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update" }
      },
      "required": ["name", "location", "capacity", "createdAt", "updatedAt"]
    },
    "FacilityBooking": {
      "title": "FacilityBooking",
      "description": "Amenity booking request and manager-approved reservation pass",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of resident reserving facility" },
        "facilityId": { "type": "string", "description": "ID of amenity venue" },
        "facilityName": { "type": "string", "description": "Display name of amenity venue" },
        "residentName": { "type": "string", "description": "Name on reservation" },
        "unit": { "type": "string", "description": "Unit or apartment number" },
        "date": { "type": "string", "description": "Reservation date" },
        "timeSlot": { "type": "string", "description": "Reserved time window" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "startHour": { "type": "integer" },
        "durationHours": { "type": "integer" },
        "guestCount": { "type": "integer", "description": "Number of attendees" },
        "notes": { "type": "string", "description": "Special requests" },
        "confirmedTimestamp": { "type": "string" },
        "approvalStatus": { "type": "string", "enum": ["PENDING", "APPROVED", "DECLINED"] },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation" }
      },
      "required": ["userId", "facilityId", "facilityName", "date", "timeSlot", "guestCount", "createdAt"]
    },
    "BookingSlotLock": {
      "title": "BookingSlotLock",
      "description": "Non-PII atomic lock preventing overlapping amenity slot bookings",
      "type": "object",
      "properties": {
        "facilityId": { "type": "string" },
        "dateKey": { "type": "string" },
        "timeSlot": { "type": "string" },
        "bookingId": { "type": "string" },
        "bookedByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["facilityId", "dateKey", "timeSlot", "bookingId", "bookedByUid", "createdAt"]
    },
    "MaintenanceEvent": {
      "title": "MaintenanceEvent",
      "description": "Estate calendar event (maintenance, general, inspection, community)",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of manager scheduling event" },
        "title": { "type": "string", "description": "Event title" },
        "discipline": { "type": "string", "description": "Engineering discipline enum key" },
        "disciplineLabel": { "type": "string", "description": "Manager-configured engineering discipline display label" },
        "eventCategory": { "type": "string", "enum": ["MAINTENANCE", "GENERAL", "INSPECTION", "COMMUNITY"] },
        "scheduledDate": { "type": "string", "description": "Scheduled date" },
        "scheduledTime": { "type": "string", "description": "Scheduled time window" },
        "contractorName": { "type": "string", "description": "Assigned contractor (optional for non-maintenance)" },
        "targetArea": { "type": "string", "description": "Target summary label" },
        "targetScope": { "type": "string", "enum": ["ALL_RESIDENTS", "SPECIFIC_UNITS"] },
        "targetUnits": { "type": "array", "items": { "type": "string" } },
        "intervalMonths": { "type": "integer", "description": "Servicing recurrence in months" },
        "status": { "type": "string", "description": "Status of event", "enum": ["SCHEDULED", "IN_PROGRESS", "COMPLETED", "OVERDUE"] },
        "notes": { "type": "string", "description": "Scope notes" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update" }
      },
      "required": ["userId", "title", "discipline", "scheduledDate", "contractorName", "status", "createdAt", "updatedAt"]
    },
    "Contract": {
      "title": "Contract",
      "description": "Residential lease agreements, contractor SLAs, and equipment warranties with archive and attachment metadata",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Agreement title" },
        "counterparty": { "type": "string", "description": "Tenant or contractor name" },
        "vendorName": { "type": "string", "description": "Counterparty display alias" },
        "unit": { "type": "string", "description": "Target unit or Estate Wide" },
        "serviceCategory": { "type": "string" },
        "type": { "type": "string", "enum": ["VENDOR_SLA", "TENANT_LEASE", "EQUIPMENT_WARRANTY"] },
        "annualValue": { "type": "string", "description": "Contract amount or monthly rent" },
        "startDate": { "type": "string" },
        "expiryDate": { "type": "string" },
        "renewalDate": { "type": "string" },
        "daysRemaining": { "type": "integer", "description": "Days until expiration" },
        "renewalTerms": { "type": "string" },
        "contactPerson": { "type": "string" },
        "contactEmail": { "type": "string" },
        "isNotificationSent": { "type": "boolean" },
        "tenantId": { "type": "string" },
        "tenantEmail": { "type": "string", "description": "Lowercase email of resident party for TENANT_LEASE" },
        "propertyId": { "type": "string" },
        "managerName": { "type": "string" },
        "managerEmail": { "type": "string" },
        "leaseStatus": { "type": "string", "enum": ["PENDING_SIGNATURE", "ACTIVE", "EXPIRED", "TERMINATED"] },
        "isSignedByTenant": { "type": "boolean" },
        "signedByName": { "type": "string" },
        "signedByEmail": { "type": "string" },
        "signedAt": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "signedContractDoc": { "type": "object" },
        "codeOfConductDoc": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update" }
      },
      "required": ["title", "annualValue", "daysRemaining", "createdAt", "updatedAt"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "Attributed estate advisory or lifecycle activity notification",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of creator" },
        "title": { "type": "string", "description": "Notice headline" },
        "message": { "type": "string", "description": "Notice body" },
        "targetAudience": { "type": "string", "description": "Target audience scope" },
        "urgency": { "type": "string", "description": "Urgency classification" },
        "timestamp": { "type": "string", "description": "Formatted timestamp" },
        "isBroadcast": { "type": "boolean", "description": "Broadcast toggle" },
        "recordType": { "type": "string", "enum": ["ANNOUNCEMENT", "ACTIVITY"], "description": "Announcement bulletin vs event-triggered activity alert" },
        "triggerEvent": {
          "type": "string",
          "enum": [
            "MANUAL_ADVISORY",
            "CASE_CREATED",
            "CASE_UPDATED",
            "CASE_VENDOR_ASSIGNED",
            "CASE_STATUS_UPDATED",
            "CASE_NOTE_ADDED",
            "CASE_REVIEWED",
            "AMENITY_BOOKED",
            "AMENITY_APPROVED",
            "AMENITY_DECLINED",
            "AMENITY_CANCELLED",
            "EVENT_SCHEDULED"
          ],
          "description": "Case lifecycle, Booking lifecycle, Event, or Manual Advisory trigger"
        },
        "createdByUid": { "type": "string", "description": "Auth UID of actor who triggered the record" },
        "createdByName": { "type": "string", "description": "Display name of actor who triggered the record" },
        "createdByEmail": { "type": "string", "description": "Email of actor who triggered the record" },
        "createdByRole": { "type": "string", "enum": ["MANAGER", "TENANT"], "description": "Role of actor who triggered the record" },
        "targetEmail": { "type": "string", "description": "Lowercase email for single resident notification" },
        "targetEmails": { "type": "array", "items": { "type": "string" }, "description": "Lowercase emails for unit-scoped notices" },
        "targetUnit": { "type": "string", "description": "Related unit or estate area" },
        "targetUnits": { "type": "array", "items": { "type": "string" }, "description": "Related units for scoped events" },
        "relatedEntityType": { "type": "string", "enum": ["ADVISORY", "CASE", "BOOKING", "EVENT"] },
        "relatedEntityId": { "type": "string", "description": "Source record document ID for deep-linking" },
        "createdAtEpochMs": { "type": "integer", "description": "Epoch millis for chronological sorting" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation" }
      },
      "required": ["userId", "title", "message", "targetAudience", "urgency", "recordType", "triggerEvent", "createdByUid", "createdByName", "createdByEmail", "createdByRole", "createdAt"]
    },
    "UserNoticeState": {
      "title": "UserNoticeState",
      "description": "Per-user synced read state for estate notifications",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner Firebase Auth UID" },
        "readNoticeIds": { "type": "array", "items": { "type": "string" }, "description": "IDs of notifications marked read by user" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update" }
      },
      "required": ["uid", "readNoticeIds", "updatedAt"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "Approved estate service contractor",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Contractor company name" },
        "category": { "type": "string", "description": "Service trade" },
        "specialty": { "type": "string" },
        "discipline": { "type": "string", "description": "Configurable contractor discipline label" },
        "phone": { "type": "string", "description": "Dispatch phone" },
        "email": { "type": "string" },
        "leadTech": { "type": "string" },
        "rating": { "type": "number", "description": "Legacy score" },
        "reviewCount": { "type": "integer", "description": "Legacy count" },
        "activeJobsCount": { "type": "integer", "description": "Open work orders" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update" }
      },
      "required": ["name", "phone", "rating", "activeJobsCount", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Authorized estate manager allowlist"
    },
    "/manager_invites/{inviteId}": {
      "schema": { "$ref": "#/entities/ManagerInvite" },
      "description": "Pending and claimed co-manager / landlord invitations"
    },
    "/estate_config/{configId}": {
      "schema": { "$ref": "#/entities/EstateConfig" },
      "description": "Configurable dropdown options for units and contractors"
    },
    "/cases/{caseId}": {
      "schema": { "$ref": "#/entities/Case" },
      "description": "Collection of maintenance incident cases and work orders"
    },
    "/properties/{propertyId}": {
      "schema": { "$ref": "#/entities/Property" },
      "description": "Collection of residential properties and specifications"
    },
    "/tenants/{tenantId}": {
      "schema": { "$ref": "#/entities/Tenant" },
      "description": "Collection of resident tenant profiles and contacts"
    },
    "/facilities/{facilityId}": {
      "schema": { "$ref": "#/entities/Facility" },
      "description": "Collection of estate shared amenities"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/FacilityBooking" },
      "description": "Collection of amenity facility reservations"
    },
    "/slot_locks/{lockId}": {
      "schema": { "$ref": "#/entities/BookingSlotLock" },
      "description": "Atomic non-PII reservation locks to prevent double-booked amenity hours"
    },
    "/maintenances/{maintenanceId}": {
      "schema": { "$ref": "#/entities/MaintenanceEvent" },
      "description": "Collection of scheduled estate calendar events"
    },
    "/contracts/{contractId}": {
      "schema": { "$ref": "#/entities/Contract" },
      "description": "Collection of lease agreements, contractor SLAs and warranties"
    },
    "/reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/Reminder" },
      "description": "Collection of attributed estate announcements and activity notifications"
    },
    "/user_notice_states/{userId}": {
      "schema": { "$ref": "#/entities/UserNoticeState" },
      "description": "Per-user synced notification read state"
    },
    "/vendors/{vendorId}": {
      "schema": { "$ref": "#/entities/Vendor" },
      "description": "Collection of approved estate contractors"
    }
  }
}
